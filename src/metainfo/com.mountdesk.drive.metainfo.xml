<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.mountdesk.drive</id>
  <name>MountDesk</name>
  <summary>Generic cloud drive desktop integration</summary>
  <description>
    <p>MountDesk integrates any cloud storage into the Linux desktop via rclone FUSE mounts.</p>
    <p>Configure any number of drives via YAML, get tray controls, colored file manager icons,
    and right-click "Open in Cloud" for all your mounted files.</p>
  </description>
  <launchable type="desktop-id">mountdesk.desktop</launchable>
  <icon type="stock">mountdesk</icon>
  <url type="homepage">https://github.com/mountdesk/mountdesk</url>
  <developer_name>André Ahlert Junior</developer_name>
  <project_license>MIT</project_license>
  <metadata_license>CC0-1.0</metadata_license>
  <releases>
    <release version="1.0.0" date="2026-05-04">
      <description><p>Initial release with YAML-configurable drives.</p></description>
    </release>
  </releases>
  <content_rating type="oars-1.1" />
</component>
