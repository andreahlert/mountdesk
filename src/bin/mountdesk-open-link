#!/usr/bin/env python3
"""
MountDesk Open Link — abre arquivo local no Google Drive web.
Se Chrome/Chromium disponível, abre em modo app window (--app=).
"""

import os
import sys
import subprocess
import yaml
import urllib.parse

CONFIG_PATH = os.path.expanduser("~/.config/mountdesk/config.yaml")


def detect_browser():
    """Detecta navegador. Prioriza Chrome/Chromium para modo app."""
    # Prioriza Chrome/Chromium porque suportam --app= (janela sem chrome)
    for cmd in ["google-chrome-stable", "chromium-browser", "chromium"]:
        if subprocess.run(["which", cmd], capture_output=True).returncode == 0:
            return cmd, True  # (cmd, suporta_app_mode)
    for cmd in ["firefox", "xdg-open"]:
        if subprocess.run(["which", cmd], capture_output=True).returncode == 0:
            return cmd, False
    return "xdg-open", False


def open_app_window(url):
    """Abre URL em janela de app do Chrome/Chromium (sem barra de endereço, sem abas)."""
    browser, supports_app = detect_browser()
    if supports_app:
        subprocess.Popen([browser, f"--app={url}"])
    else:
        subprocess.Popen([browser, url])


def main():
    if len(sys.argv) < 2:
        print("Usage: mountdesk-open-link <file-path>")
        sys.exit(1)

    filepath = os.path.abspath(sys.argv[1])

    try:
        with open(CONFIG_PATH) as f:
            config = yaml.safe_load(f) or {}
    except Exception:
        print("Error reading config")
        sys.exit(1)

    # Encontrar qual drive/mountpoint corresponde ao arquivo
    matched_remote = None
    rel_path = None

    for drive in config.get("drives", []):
        mountpoint = os.path.expanduser(drive["mountpoint"])
        if filepath.startswith(mountpoint):
            matched_remote = drive["remote"]
            matched_mount = mountpoint
            rel_path = filepath[len(mountpoint):].lstrip("/")
            break

    if not matched_remote:
        print("File is not in any configured mountpoint.")
        sys.exit(1)

    # Tentar obter ID do arquivo via rclone
    try:
        result = subprocess.run(
            ["rclone", "lsjson", f"{matched_remote}:{rel_path}"],
            capture_output=True, text=True, timeout=10
        )
        if result.returncode == 0:
            import json
            data = json.loads(result.stdout)
            if data and len(data) > 0:
                item = data[0]
                fid = item.get("ID", "")
                mime = item.get("MimeType", "")
                if fid:
                    if "spreadsheet" in mime:
                        url = f"https://docs.google.com/spreadsheets/d/{fid}/edit"
                    elif "presentation" in mime:
                        url = f"https://docs.google.com/presentation/d/{fid}/edit"
                    elif "document" in mime:
                        url = f"https://docs.google.com/document/d/{fid}/edit"
                    else:
                        url = f"https://drive.google.com/file/d/{fid}/view"
                    open_app_window(url)
                    return
    except Exception:
        pass

    # Fallback: abrir a pasta no Drive
    url = "https://drive.google.com/drive/my-drive"
    open_app_window(url)


if __name__ == "__main__":
    main()
