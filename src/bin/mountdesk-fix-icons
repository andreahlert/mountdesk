#!/usr/bin/env python3
"""
MountDesk - Fix icons for zero-size rclone Google Doc exports.
Reads drive configuration from ~/.config/mountdesk/config.yaml
"""

import os
import yaml

CONFIG_PATH = os.path.expanduser("~/.config/mountdesk/config.yaml")

ICON_BASE = os.path.expanduser("~/.local/share/icons/hicolor/48x48/apps")
SYSTEM_ICON_BASE = "/usr/share/icons/hicolor/48x48/apps"

ICON_MAP = {
    "xlsx": "google-sheets.png",
    "XLSX": "google-sheets.png",
    "ods": "google-sheets.png",
    "ODS": "google-sheets.png",
    "csv": "google-sheets.png",
    "CSV": "google-sheets.png",
    "docx": "google-docs.png",
    "DOCX": "google-docs.png",
    "odt": "google-docs.png",
    "ODT": "google-docs.png",
    "txt": "text-x-generic",
    "TXT": "text-x-generic",
    "pptx": "google-slides.png",
    "PPTX": "google-slides.png",
    "odp": "google-slides.png",
    "ODP": "google-slides.png",
    "pdf": "application-pdf",
    "PDF": "application-pdf",
    "png": "image-x-generic",
    "PNG": "image-x-generic",
    "jpg": "image-x-generic",
    "JPG": "image-x-generic",
    "jpeg": "image-x-generic",
    "JPEG": "image-x-generic",
}


def get_icon_path(icon_name):
    user_path = os.path.join(ICON_BASE, icon_name)
    if os.path.exists(user_path):
        return user_path
    system_path = os.path.join(SYSTEM_ICON_BASE, icon_name)
    if os.path.exists(system_path):
        return system_path
    return None


def fix_icons_in_dir(directory):
    fixed = 0
    for root, _dirs, files in os.walk(directory):
        for fname in files:
            ext = os.path.splitext(fname)[1][1:]
            icon_file = ICON_MAP.get(ext)
            if not icon_file:
                continue
            filepath = os.path.join(root, fname)
            if icon_file.endswith(".png"):
                icon_path = get_icon_path(icon_file)
                if not icon_path:
                    continue
                os.system(f'gio set "{filepath}" metadata::custom-icon "file://{icon_path}" 2>/dev/null')
            else:
                os.system(f'gio set "{filepath}" metadata::custom-icon-name "{icon_file}" 2>/dev/null')
            fixed += 1
    return fixed


def main():
    try:
        with open(CONFIG_PATH) as f:
            config = yaml.safe_load(f) or {}
    except Exception as e:
        print(f"Failed to load config: {e}")
        return

    drives = config.get("drives", [])
    total = 0
    for drive in drives:
        mountpoint = os.path.expanduser(drive.get("mountpoint", ""))
        if os.path.isdir(mountpoint):
            n = fix_icons_in_dir(mountpoint)
            total += n
            print(f"Fixed icons in {drive['name']}: {n} files")
    print(f"Done. Total: {total} files. Press F5 in Nemo to refresh.")


if __name__ == "__main__":
    main()
