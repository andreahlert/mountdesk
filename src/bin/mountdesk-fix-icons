#!/usr/bin/env python3
"""
MountDesk Fix Icons — aplica metadata::custom-icon para arquivos Google.
Versão eficiente: só processa arquivos no diretório raiz de cada mountpoint
(sem recursão profunda que trava em FUSE).
"""

import os
import subprocess
import yaml

CONFIG_PATH = os.path.expanduser("~/.config/mountdesk/config.yaml")

ICON_MAP = {
    ".xlsx": "google-sheets",
    ".XLSX": "google-sheets",
    ".ods": "google-sheets",
    ".ODS": "google-sheets",
    ".csv": "google-sheets",
    ".CSV": "google-sheets",
    ".docx": "google-docs",
    ".DOCX": "google-docs",
    ".odt": "google-docs",
    ".ODT": "google-docs",
    ".txt": "google-docs",
    ".TXT": "google-docs",
    ".pptx": "google-slides",
    ".PPTX": "google-slides",
    ".odp": "google-slides",
    ".ODP": "google-slides",
    ".pdf": "google-docs",
    ".PDF": "google-docs",
}


def find_icon_path(icon_name):
    for size in ["256x256", "128x128", "96x96", "64x64", "48x48", "scalable"]:
        for ext in ["png", "svg"]:
            path = f"/usr/share/icons/hicolor/{size}/apps/{icon_name}.{ext}"
            if os.path.exists(path):
                return path
            path = os.path.expanduser(f"~/.local/share/icons/hicolor/{size}/apps/{icon_name}.{ext}")
            if os.path.exists(path):
                return path
    return None


def apply_icon(filepath, icon_path):
    try:
        subprocess.run(
            ["gio", "set", filepath, "metadata::custom-icon", f"file://{icon_path}"],
            capture_output=True, check=False, timeout=5
        )
        return True
    except Exception:
        return False


def main():
    try:
        with open(CONFIG_PATH) as f:
            config = yaml.safe_load(f) or {}
    except Exception:
        print("Error reading config")
        return

    for drive in config.get("drives", []):
        mountpoint = os.path.expanduser(drive.get("mountpoint", ""))
        if not os.path.isdir(mountpoint):
            continue

        print(f"Processing {drive.get('name', mountpoint)}...")
        count = 0

        # Processa apenas 1 nível de profundidade (raiz do mount)
        # FUSE pode travar com os.walk() profundo
        try:
            entries = os.listdir(mountpoint)
        except PermissionError:
            continue

        for entry in entries:
            filepath = os.path.join(mountpoint, entry)
            if not os.path.isfile(filepath):
                continue

            ext = os.path.splitext(entry)[1]
            icon_name = ICON_MAP.get(ext)
            if not icon_name:
                continue

            icon_path = find_icon_path(icon_name)
            if not icon_path:
                continue

            if apply_icon(filepath, icon_path):
                count += 1

        # Também processa 1 subdiretório de cada pasta
        for entry in entries:
            subdir = os.path.join(mountpoint, entry)
            if not os.path.isdir(subdir):
                continue
            try:
                subentries = os.listdir(subdir)
            except PermissionError:
                continue
            for subentry in subentries:
                filepath = os.path.join(subdir, subentry)
                if not os.path.isfile(filepath):
                    continue
                ext = os.path.splitext(subentry)[1]
                icon_name = ICON_MAP.get(ext)
                if not icon_name:
                    continue
                icon_path = find_icon_path(icon_name)
                if not icon_path:
                    continue
                if apply_icon(filepath, icon_path):
                    count += 1

        print(f"  {count} icons applied")


if __name__ == "__main__":
    main()
